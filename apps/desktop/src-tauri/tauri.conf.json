{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duet",
  "version": "0.1.0",
  "identifier": "app.duet.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Duet",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.ts.net http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Finance",
    "shortDescription": "A local-first money app for two",
    "copyright": "AGPL-3.0",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "duet"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBMjlDMzhBQzBEQzQ0RjIKUldUeVJOekFpc01wU2g2NVdia0JudUd4VHdYTnFDY1ZuZkVJdktIR2s5UmxOK0JSaXlmMnlqY1YK",
      "endpoints": [
        "https://github.com/firstprateek/duet/releases/latest/download/latest.json"
      ]
    }
  }
}
