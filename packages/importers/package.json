{
  "name": "@duet/importers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Reads bank and card statements (CSV, XLSX, OFX/QFX) into plain rows. Bank profiles are plain data, so adding a bank is a small pull request.",
